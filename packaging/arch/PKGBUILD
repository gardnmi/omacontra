# Maintainer: gardnmi <https://github.com/gardnmi>
# Pinned release archive; checksum must match install.sh.
pkgname=omacontra
pkgver=1.0.0
pkgrel=1
pkgdesc='Contra-inspired wallpaper boss rush for Omarchy and Hyprland'
arch=('any')
url='https://github.com/gardnmi/omacontra'
# MIT covers original code; bundled assets retain separate terms.
license=('MIT' 'CC0-1.0' 'CC-BY-3.0' 'CC-BY-4.0' 'LicenseRef-Omacontra-Assets')
depends=('python' 'python-gobject' 'python-cairo' 'gtk3' 'mpv' 'sdl2-compat' 'hyprland>=0.55')
_release=v1.0.0
source=("${url}/releases/download/${_release}/omacontra-runtime.tar.gz"
        'omacontra.sh'
        'omacontra.desktop')
sha256sums=('ad26f480f9c1a0451bd24af3af859ae20dc18f7f752896964bf0f1e5ade20ee3'
            'dfe19c75ab0b0da99b3324aae5dfbd6dd56a41a8e13267ed6030f7bdaffffa02'
            '6f45d09d1b7c2892d7b16b76964351741506d599f429795263fa976712955992')

package() {
    local game="${pkgdir}/usr/share/omacontra"
    python -c 'import sys; sys.path.insert(0, sys.argv[1]); from release_assets import stage_game; stage_game(sys.argv[1], sys.argv[2])' "${srcdir}/omacontra" "$game"
    # Never ship developer bytecode or inherit writable/executable asset modes.
    find "$game" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$game" -type f -name '*.py[co]' -delete
    find "$game" -type d -exec chmod 755 {} +
    find "$game" -type f -exec chmod 644 {} +
    install -Dm755 "${srcdir}/omacontra.sh" "${pkgdir}/usr/bin/omacontra"
    install -Dm644 "${srcdir}/omacontra.desktop" "${pkgdir}/usr/share/applications/omacontra.desktop"
    install -Dm644 "$game/assets/omacontra-cover-v2.png" "${pkgdir}/usr/share/pixmaps/omacontra.png"
    install -Dm644 "$game/THIRD_PARTY/README.md" "${pkgdir}/usr/share/licenses/omacontra/NOTICE"
    install -m644 "$game/LICENSE" "$game/THIRD_PARTY/ASSET_RIGHTS.md" "${pkgdir}/usr/share/licenses/omacontra/"
    install -m644 "$game/THIRD_PARTY/hyprsplitter-LICENSE.txt" "${pkgdir}/usr/share/licenses/omacontra/"
}
